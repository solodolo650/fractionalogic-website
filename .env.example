# Copy to .env (local) or set in your host's environment settings.

# Public site URL, no trailing slash. Enables canonical URLs and sitemap.xml.
# Leave unset on preview/review deployments: without it every page carries
# <meta name="robots" content="noindex, nofollow"> so search engines skip it.
SITE_URL=https://fractionalogic.com

# Form endpoint for Talk to Us and the roster application.
# Any provider that accepts a multipart POST works (Formspree, Web3Forms, Basin, Getform).
# e.g. https://formspree.io/f/xxxxxxx  or  https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# Only for providers that expect a key inside the payload (Web3Forms calls it access_key).
PUBLIC_FORM_ACCESS_KEY=
