---
import Base from '../layouts/Base.astro';
import { routes } from '../data/site';

const suggestions = [
  { label: 'Fractional CMO', href: routes.fcmo },
  { label: 'Fractional Twinning', href: routes.twinning },
  { label: 'Resources', href: routes.resources },
  { label: 'Talk to Us', href: routes.talkToUs },
];
---

<Base title="Page not found | Fractionalogic" description="The page you were looking for isn’t here.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="missing container">
    <h1 class="page-title">This page isn’t here.</h1>
    <p class="lede">The link may be out of date, or the page may have moved. These are the pages most people look for:</p>
    <ul class="chip-list">
      {
        suggestions.map((s) => (
          <li>
            <a class="chip missing__link" href={s.href}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary" href={routes.home}>Go to the homepage</a>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-top: clamp(72px, 10vw, 140px);
  }

  .missing__link {
    text-decoration: none;
  }

  .missing__link:hover {
    border-color: var(--color-action);
    color: var(--color-action);
  }
</style>
