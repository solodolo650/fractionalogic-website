---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import mountain from '../../assets/images/card-fcmo-mountain.png';
import { routes } from '../../data/site';

const steps = [
  { name: 'Diagnose', text: 'Establish where the business actually stands: ICP and market definition, positioning, and the growth constraint that matters most.' },
  { name: 'Decide', text: 'Convert the diagnosis into a go-to-market roadmap with named priorities, owners, and KPIs.' },
  { name: 'Build', text: 'Stand up demand generation, sales alignment, content, and MarTech as one connected system, not isolated activities.' },
  { name: 'Sustain', text: 'Run the operating rhythm, coach the internal team, and hand over capability that outlives the engagement.' },
];

// Bento order and tone are set here; the grid places tiles by their `span` class.
const coverage = [
  { area: 'Strategic Foundation', detail: 'ICP and market definition, brand positioning and messaging frameworks, go-to-market roadmaps.', tone: 'dark', span: 'wide' },
  { area: 'C-Suite Strategic Advisory', detail: 'A sounding board for founders and CEOs on growth, fundraising readiness, and market expansion.', tone: 'mist', span: 'narrow' },
  {
    area: 'Demand Generation & Pipeline',
    detail: 'Full-funnel demand generation across SEO, content, email, paid, and ABM; lead funnel architecture; MQL and SQL definitions; growth experiments.',
    tone: 'teal',
    span: 'half',
  },
  { area: 'Sales & Revenue Alignment', detail: 'Sales enablement assets, pipeline velocity optimization, CRM configuration.', tone: 'surface', span: 'half' },
  { area: 'Brand & Content Leadership', detail: 'Content playbooks, product launches, customer lifecycle marketing.', tone: 'surface', span: 'third' },
  {
    area: 'MarTech & Performance Management',
    detail: 'KPI and OKR frameworks, MarTech stack selection, attribution and reporting, budget allocation.',
    tone: 'mist',
    span: 'third',
  },
  { area: 'Team & Vendor Leadership', detail: 'Hiring, agency management, and coaching internal teams to self-sufficiency.', tone: 'surface', span: 'third' },
];

const stages = [
  {
    label: 'Early-stage startup',
    text: 'At a growth inflection point, needing brand visibility and a credible go-to-market plan. The FCMO establishes the ICP, positioning, and the first repeatable demand motion before committing headcount.',
  },
  {
    label: 'Established SME',
    text: 'Needs high-level marketing direction without full-time staff overhead. The FCMO brings structure, KPI discipline, and MarTech decisions, and coaches the existing team to run the system.',
  },
  {
    label: 'Larger business or business in transition',
    text: 'Rebranding, merger, pivot, or operating without dedicated marketing leadership. The FCMO supplies objective senior judgment unaffected by internal politics or legacy thinking, and — where complexity spans functions — becomes the anchor for a Twinning pairing.',
  },
];

const industries = [
  'IT and ITES',
  'FinTech and financial services',
  'Manufacturing and industrial',
  'Retail and e-commerce',
  'FMCG and food service',
  'Consumer durables',
  'Education and EdTech',
  'Healthcare and life sciences',
  'Trade associations',
  'Social services and nonprofits',
];

// Hero proof: the services companies rank highest in an FCMO engagement.
const topServices = [
  { name: 'Strategic planning', value: 92.67 },
  { name: 'Marketing strategy development', value: 88.67 },
  { name: 'Content strategy', value: 82.67 },
];

const benefits = [
  { name: 'Strategic Clarity', text: 'Align goals, priorities and positioning in one accountable roadmap.' },
  { name: 'Lower Overhead', text: 'Access CMO-level expertise without the cost of a full-time hire.' },
  { name: 'Objective Perspective', text: 'Challenge assumptions, uncover blind spots and make better decisions.' },
  { name: 'Flexible Leadership', text: 'Scale leadership involvement as your business needs change.' },
  { name: 'Proven Thinking', text: 'Apply cross-market insights to build your team’s knowledge.' },
  { name: 'Faster Execution', text: 'Move from scattered activity to focused decisions and action.' },
  { name: 'Lasting Capability', text: 'Strengthen your team, systems and operating rhythms for the future.' },
];
---

<Base
  title="Fractional CMO for Growth-Stage B2B SaaS | Fractionalogic"
  description="Senior, revenue-accountable marketing leadership — embedded in your team, part-time in hours, full-time in ownership. How a Fractionalogic FCMO engagement works."
>
  <PageHeader
    title="Fractional CMO."
    current="Fractional CMO"
    crumbs={[{ label: 'Services' }]}
    lede="Fractional CMO is our core practice. We align marketing strategy, investment, and execution with your business priorities, balancing short-term needs with long-term brand strength. Get your senior marketing leadership without the cost and commitment of a full-time hire."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={routes.bookConversation}>Talk to your FCMO</a>
    </Fragment>
    <figure slot="aside" class="compare" aria-labelledby="compare-caption">
      <figcaption id="compare-caption" class="compare__caption">Top-ranked FCMO services</figcaption>
      {
        topServices.map((svc) => (
          <div class="compare__row">
            <span class="compare__label">{svc.name}</span>
            <span class="compare__track">
              <span class="compare__bar compare__bar--lead compare__bar--pct" style={`--v: ${svc.value}`} />
            </span>
            <span class="num compare__value">{svc.value}%</span>
          </div>
        ))
      }
    </figure>
  </PageHeader>

  <section class="how container section" aria-labelledby="how-title">
    <div class="split how__head">
      <h2 id="how-title" class="h2">How it works</h2>
      <p>
        Every engagement runs the same four stages: from an honest read of what is holding growth back to a system your own team
        can run. The engagement builds through connected layers, in sequence:
      </p>
    </div>
    <ol class="flow">
      {
        steps.map((step, i) => (
          <li class="flow__step">
            <span class="flow__marker num" aria-hidden="true">{i + 1}</span>
            <h3 class="flow__name">{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="coverage container section" aria-labelledby="coverage-title">
    <div class="section-head">
      <h2 id="coverage-title" class="h2">What’s covered</h2>
    </div>
    <ul class="bento">
      {
        coverage.map((c) => (
          <li class:list={['bento__tile', `bento__tile--${c.tone}`, `bento__tile--${c.span}`, { 'on-dark': c.tone === 'dark' || c.tone === 'teal' }]}>
            <h3 class="bento__title">{c.area}</h3>
            <p class="bento__text">{c.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="serve container section" aria-labelledby="serve-title">
    <div class="serve__block">
      <div class="serve__intro">
        <h2 id="serve-title" class="h2">Who we serve</h2>
        <p>
          One persona: a founder or CEO who owns the growth number and has outgrown founder-led marketing. The stage changes, not
          the person.
        </p>
      </div>
      <ul class="serve__stages">
        {
          stages.map((stage) => (
            <li>
              <h3 class="serve__stage-name">{stage.label}</h3>
              <p>{stage.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="value container section" aria-labelledby="value-title">
    <div class="split value__head">
      <h2 id="value-title" class="h2">Benefits &amp; ROI</h2>
      <p>
        Gain the strategic direction, operating discipline, and team leadership your business needs — without the permanent
        overhead of a full-time CMO. Embedded in your business and accountable for revenue, a Fractional CMO brings seasoned
        executive judgment and an objective perspective, with involvement and a cost structure aligned with your stage of
        growth.
      </p>
    </div>

    <ul class="value__grid">
      <li class="value__tile value__tile--dark on-dark">
        <p class="value__label">Savings</p>
        <p class="num value__figure">~50%</p>
        <p>A 2026 dataset: a 10-hour-a-week fractional executive costs about 50% less than a fully loaded full-time hire.</p>
      </li>
      <li class="value__tile value__tile--teal on-dark">
        <p class="value__label">Objectivity</p>
        <p class="num value__figure">63%</p>
        <p>Of companies cite objective insight as a reason they use fractional talent.</p>
      </li>
      <li class="value__tile value__tile--mist">
        <p class="value__label">Flexibility</p>
        <p class="num value__figure">83%</p>
        <p>Of businesses chose fractional leadership for flexibility and autonomy.</p>
      </li>
    </ul>

    <ul class="benefits">
      {
        benefits.map((b) => (
          <li>
            <h3 class="benefits__name">{b.name}</h3>
            <p>{b.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="value__engage">
      <p>Choose your model of engagement. Get clarity. Get going.</p>
      <a class="btn btn-primary" href={routes.bookConversation}>Engage with us</a>
    </div>
  </section>

  <section class="industries container section" aria-labelledby="industries-title">
    <div class="section-head">
      <h2 id="industries-title" class="h2">Industries we serve</h2>
    </div>
    <ul class="industries__grid">
      {industries.map((name) => <li>{name}</li>)}
    </ul>
  </section>

  <CtaBand
    title="Start with a diagnostic conversation."
    body="Every engagement starts with a diagnostic conversation on your current marketing leadership gap, growth stage, and go-to-market priorities."
    action={{ label: 'Book an FCMO Conversation', href: routes.bookConversation }}
    image={mountain}
  />
</Base>

<style>
  .section-head + * {
    margin-top: 40px;
  }

  /* Hero aside ------------------------------------------------------ */
  .compare {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: clamp(24px, 3vw, 36px);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .compare__caption {
    font-weight: 600;
    color: var(--color-heading);
  }

  .compare__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 16px;
    align-items: center;
  }

  .compare__label {
    grid-column: 1 / -1;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .compare__track {
    display: block;
    height: 14px;
    background: var(--color-canvas);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .compare__bar {
    display: block;
    width: calc(var(--v) / 70 * 100%);
    height: 100%;
    background: var(--color-rule);
    border-radius: var(--radius-pill);
  }

  .compare__bar--pct {
    width: calc(var(--v) * 1%);
  }

  .compare__bar--lead {
    background: var(--color-action);
  }

  .compare__value {
    font-size: 1.75rem;
    line-height: 1;
  }

  /* How it works ---------------------------------------------------- */
  /* One row, four stages, read left to right in a glance: a numbered marker
     on a single connecting rule, the stage name, one sentence. */
  .how__head {
    align-items: end;
  }

  .how__head p {
    max-width: var(--measure);
  }

  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .flow::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 22px;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-action), var(--color-panel));
  }

  .flow__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .flow__marker {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    background: var(--color-canvas);
    border: 2px solid var(--color-action);
    border-radius: 50%;
    font-size: 1.0625rem;
    color: var(--color-action);
  }

  .flow__step:first-child .flow__marker {
    background: var(--color-action);
    color: var(--color-on-dark);
  }

  .flow__name {
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* Coverage bento -------------------------------------------------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .bento__tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 240px;
    padding: clamp(24px, 3vw, 32px);
    border-radius: var(--radius);
    color: var(--color-text-on-panel);
  }

  .bento__tile--wide {
    grid-column: span 4;
    min-height: 300px;
  }

  .bento__tile--narrow {
    grid-column: span 2;
    min-height: 300px;
  }

  .bento__tile--half {
    grid-column: span 3;
  }

  .bento__tile--third {
    grid-column: span 2;
  }

  .bento__tile--dark {
    color: var(--color-on-dark);
  }

  .bento__tile--teal {
    background: linear-gradient(135deg, var(--color-brand), var(--color-action));
    color: var(--color-on-dark);
  }

  .bento__tile--mist {
    background: var(--color-panel);
  }

  .bento__tile--surface {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
  }

  .bento__title {
    max-width: 14em;
    font-size: clamp(1.375rem, 0.8vw + 1.1rem, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .bento__tile--wide .bento__title {
    font-size: clamp(1.75rem, 1.4vw + 1.25rem, 2.25rem);
  }

  .bento__text {
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .on-dark .bento__text {
    color: var(--color-on-dark-muted);
  }

  /* A soft glow keeps the dark lead tile from reading flat. */
  .bento__tile--dark {
    background:
      radial-gradient(70% 90% at 100% 0%, color-mix(in srgb, var(--color-action) 55%, transparent), transparent 70%),
      linear-gradient(135deg, var(--color-dark) 30%, var(--color-brand));
  }

  /* Who we serve ---------------------------------------------------- */
  .serve__block {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px clamp(40px, 6vw, 80px);
    padding: clamp(28px, 4vw, 56px);
    background: var(--color-panel);
    border-radius: var(--radius);
    color: var(--color-text-on-panel);
  }

  .serve__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .serve__stages {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-panel);
  }

  .serve__stages li {
    display: grid;
    gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-rule-on-panel);
  }

  .serve__stages li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .serve__stage-name {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /* Benefits & ROI -------------------------------------------------- */
  .value__head {
    align-items: end;
  }

  .value__head p {
    max-width: var(--measure);
  }

  .value__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .value__tile {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(24px, 3vw, 32px);
    border-radius: var(--radius);
  }

  .value__tile--dark,
  .value__tile--teal,
  .value__tile--mist {
    grid-column: span 2;
    min-height: 280px;
  }

  .value__tile--dark {
    background: linear-gradient(160deg, var(--color-dark) 40%, var(--color-brand));
  }

  .value__tile--teal {
    background: linear-gradient(160deg, var(--color-brand), var(--color-action));
  }

  .value__tile--mist {
    background: var(--color-panel);
    color: var(--color-text-on-panel);
  }

  .value__tile--text {
    grid-column: span 3;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
  }

  .value__label {
    margin-bottom: auto;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .on-dark .value__label {
    color: var(--color-on-dark-muted);
  }

  .value__figure {
    margin-top: 32px;
    font-size: clamp(3rem, 2.4vw + 2rem, 4.25rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  /* The range dash needs air at display size. */
  .value__dash {
    margin-inline: 0.08em;
    font-weight: 400;
  }

  .value__title {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /* Seven benefits as one ruled strip: four across, wrapping to three. */
  .benefits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 32px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .benefits li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 20px 0 24px;
    border-top: 1px solid var(--color-rule);
  }

  .benefits__name {
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .benefits p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .value__engage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--color-rule);
  }

  .value__engage p {
    max-width: var(--measure);
    font-size: 1.0625rem;
    color: var(--color-heading);
  }

  /* Industries ------------------------------------------------------ */
  /* Spaced blocks on the page's 16px rhythm, each with a Mist wash. */
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .industries__grid li {
    display: flex;
    align-items: flex-end;
    min-height: 128px;
    padding: 20px 24px;
    background: linear-gradient(160deg, var(--color-panel), color-mix(in srgb, var(--color-panel) 35%, var(--color-surface)));
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-heading);
  }

  @media (max-width: 900px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }

    .flow::before {
      display: none;
    }

    .benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento,
    .value__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento__tile--wide,
    .bento__tile--narrow,
    .bento__tile--half,
    .bento__tile--third,
    .value__tile--dark,
    .value__tile--teal,
    .value__tile--mist,
    .value__tile--text {
      grid-column: span 1;
      min-height: 0;
    }

    .bento__tile--wide,
    .value__tile--dark {
      grid-column: 1 / -1;
    }

    .serve__block {
      grid-template-columns: 1fr;
    }

    .industries__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .bento,
    .value__grid {
      grid-template-columns: 1fr;
    }

    .flow,
    .benefits {
      grid-template-columns: 1fr;
    }

    .industries__grid {
      gap: 12px;
    }

    .industries__grid li {
      min-height: 88px;
      padding: 16px;
      font-size: 1.0625rem;
    }

    .value__engage .btn {
      width: 100%;
    }
  }
</style>
