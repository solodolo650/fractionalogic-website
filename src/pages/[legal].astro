---
/* Legal pages share one template; the text lives in src/data/legal.ts. */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { legal, legalUpdated } from '../data/legal';

export function getStaticPaths() {
  return (Object.keys(legal) as (keyof typeof legal)[]).map((slug) => ({ params: { legal: slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: keyof typeof legal };
const page = legal[slug];

/* Escape the text, then link URLs and email addresses. */
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (s: string) =>
  esc(s)
    .replace(/https?:\/\/[^\s)]+?(?=[.,;)]?(\s|$))/g, (u) => `<a href="${u}" rel="noopener">${u.replace(/^https?:\/\//, '')}</a>`)
    .replace(/[\w.+-]+@[\w-]+\.[\w.]+\w/g, (m) => `<a href="mailto:${m}">${m}</a>`);
---

<Base title={`${page.title} | Fractionalogic`} description={`Fractionalogic ${page.title}.`}>
  <meta slot="head" name="robots" content="noindex" />
  <PageHeader title={page.title} lede={page.lede}>
    <p class="legal__updated">
      Last updated <time datetime={legalUpdated.iso}>{legalUpdated.label}</time>
    </p>
  </PageHeader>
  <div class="container legal-body">
    <div class="legal">
      {
        page.blocks.map((b) =>
          'h' in b ? (
            <h2>{b.h}</h2>
          ) : 'p' in b ? (
            <p set:html={rich(b.p)} />
          ) : 'ul' in b ? (
            <ul>
              {b.ul.map((li) => (
                <li set:html={rich(li)} />
              ))}
            </ul>
          ) : (
            <div class="legal__table">
              <table>
                <thead>
                  <tr>
                    {b.table.head.map((c) => (
                      <th scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {b.table.rows.map((r) => (
                    <tr>
                      {r.map((c) => (
                        <td>{c}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ),
        )
      }
    </div>
  </div>
</Base>

<style>
  .legal__updated {
    font-size: 0.875rem;
    color: var(--color-on-dark-muted);
  }

  .legal__updated time {
    font-weight: 600;
    color: var(--color-on-dark);
  }

  /* Policy text follows the header closely; a full section gap reads as a break. */
  .legal-body {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .legal {
    display: grid;
    gap: 14px;
    max-width: var(--measure);
    overflow-wrap: anywhere;
  }

  .legal h2 {
    margin-top: 24px;
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .legal h2:first-child {
    margin-top: 0;
  }

  .legal ul {
    display: grid;
    gap: 8px;
    padding-left: 20px;
    list-style: disc;
  }

  .legal :global(a) {
    color: var(--color-action);
    font-weight: 600;
  }

  .legal__table {
    overflow-x: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .legal table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: normal;
  }

  .legal th,
  .legal td {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-rule);
  }

  .legal th {
    background: var(--color-panel);
    color: var(--color-text-on-panel);
    font-weight: 600;
  }

  .legal tr:last-child td {
    border-bottom: 0;
  }
</style>
