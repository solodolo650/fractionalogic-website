---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import FilterGroup from '../../components/ui/FilterGroup.astro';
import ResourceCard from '../../components/ui/ResourceCard.astro';
import { faqs } from '../../data/faqs';
import { getResources, kindCategories, type ResourceKind } from '../../lib/resources';

const resources = await getResources();
const kinds = [...new Set(resources.map((r) => r.data.kind))] as ResourceKind[];
const categories = kinds.map((kind) => ({
  value: kind,
  label: kindCategories[kind],
  count: resources.filter((r) => r.data.kind === kind).length,
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Base
  title="Resources | Fractional CMO Reports, Case Studies and FAQs | Fractionalogic"
  description="Reports, points of view, case studies, and answers on Fractional CMO and Fractional Twinning engagements — in one place."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHeader
    title="Resources"
    lede="Reports, points of view, case studies, and answers — in one place. Data, KPIs, and named sources back every claim on this site."
  />

  <section class="library container" aria-label="Resource library">
    <FilterGroup label="Filter resources by type" options={categories} total={resources.length} noun={['resource', 'resources']} param="type">
      <ul class="library__grid">
        {
          resources.map((r) => (
            <li data-filter-tags={r.data.kind}>
              <ResourceCard resource={r} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </FilterGroup>
  </section>

  <section id="faq" class="faq container section" aria-labelledby="faq-title">
    <h2 id="faq-title" class="h2">Frequently asked questions</h2>
    <div class="faq__list">
      {
        faqs.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.question}</span>
              <svg class="faq__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M8 3v10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="faq__answer">
              <p>{f.answer}</p>
              {f.link && (
                <a class="text-link" href={f.link.href}>
                  {f.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .library {
    margin-top: clamp(40px, 5vw, 56px);
  }

  .library__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  /* FAQ ------------------------------------------------------------ */
  .faq {
    display: grid;
    gap: 32px;
  }

  .faq__list {
    border-top: 1px solid var(--color-rule);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-rule);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: clamp(1.0625rem, 0.4vw + 1rem, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--color-action);
  }

  .faq__icon {
    flex-shrink: 0;
    color: var(--color-action);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    display: grid;
    justify-items: start;
    gap: 12px;
    max-width: var(--measure);
    padding-bottom: 24px;
  }

  @media (max-width: 900px) {
    .library__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .library__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
