---
/* A page for every resource that isn't hosted elsewhere: reports, and articles published through the CMS. */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ResourceCard from '../../components/ui/ResourceCard.astro';
import { routes } from '../../data/site';
import { getResources, isExternal, kindCategories, kindLabels, type Resource } from '../../lib/resources';

export async function getStaticPaths() {
  const resources = await getResources();
  return resources.filter((r) => !isExternal(r)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Resource;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, kind, audience, file, downloadLabel, companion, date } = entry.data;
const hasBody = Boolean(entry.body?.trim());
const related = (await getResources()).filter((r) => r.data.kind === kind && r.id !== entry.id).slice(0, 3);
---

<Base title={`${title} | Fractionalogic Resources`} description={summary ?? title}>
  <PageHeader title={title} crumbs={[{ label: 'Resources', href: routes.resources }]} lede={summary}>
    <p class="detail__meta">
      <span>{kindLabels[kind]}</span>
      {date && <time datetime={date.toISOString()}>{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
    </p>
    {
      kind === 'report' && (
        <div class="detail__actions">
          {file ? (
            <a class="btn btn-primary" href={file} download>
              {downloadLabel ?? `Download ${title}`}
            </a>
          ) : (
            <p class="detail__pending">PDF coming soon</p>
          )}
          {companion && (
            <a class="text-link detail__companion" href={companion.url} rel="noopener">
              Free to read: {companion.label}
            </a>
          )}
        </div>
      )
    }
  </PageHeader>

  {
    (audience || hasBody) && (
      <div class="container detail">
        {audience && (
          <div class="detail__audience">
            <h2 class="detail__label">Written for</h2>
            <p>{audience}</p>
          </div>
        )}
        {hasBody && (
          <article class="article">
            <Content />
          </article>
        )}
      </div>
    )
  }

  {
    related.length > 0 && (
      <section class="container section related" aria-labelledby="related-title">
        <div class="related__head">
          <h2 id="related-title" class="h3">More {kindCategories[kind].toLowerCase()}</h2>
          <a class="text-link" href={`${routes.resources}?type=${kind}`}>
            All {kindCategories[kind].toLowerCase()} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="related__grid">
          {related.map((r) => (
            <li>
              <ResourceCard resource={r} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .detail__meta {
    display: flex;
    gap: 16px;
    font-weight: 600;
    color: var(--color-action);
  }

  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 8px;
  }

  .detail__pending {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 12px 20px;
    border: 1px dashed var(--color-field-border);
    border-radius: var(--radius);
    font-weight: 500;
  }

  .detail__companion {
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
  }

  .detail {
    display: grid;
    gap: 40px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .detail__audience {
    display: grid;
    gap: 8px;
    max-width: var(--measure);
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
  }

  .detail__label {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .article {
    display: grid;
    gap: 20px;
    max-width: var(--measure);
  }

  .article :global(h2) {
    margin-top: 28px;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .article :global(h3) {
    margin-top: 16px;
    font-size: 1.3125rem;
  }

  .article :global(ul),
  .article :global(ol) {
    display: grid;
    gap: 8px;
    padding-left: 22px;
    list-style: revert;
  }

  .article :global(a) {
    color: var(--color-action);
    text-underline-offset: 4px;
  }

  .article :global(blockquote) {
    margin: 8px 0;
    padding-left: 20px;
    border-left: 1px solid var(--color-action);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-heading);
  }

  .article :global(img) {
    border-radius: var(--radius);
  }

  .related {
    display: grid;
    gap: 28px;
  }

  .related__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .related__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
