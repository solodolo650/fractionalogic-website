---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import FilterGroup from '../../components/ui/FilterGroup.astro';
import PartnerCard from '../../components/ui/PartnerCard.astro';
import Form from '../../components/forms/Form.astro';
import Field from '../../components/forms/Field.astro';
import { initials, partnerFunctions, roster } from '../../data/partners';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const functionOptions = [
  'Marketing',
  'Revenue and sales',
  'Finance',
  'Technology and AI',
  'Operations',
  'People and HR',
  'Digital transformation',
  'Personal branding',
  'Other',
];

const functionSummary = new Intl.ListFormat('en', { type: 'conjunction' }).format(
  partnerFunctions.map((f) => f.toLowerCase().replace('ai', 'AI')),
);

const regionOptions = ['India', 'APAC', 'Middle East', 'United Kingdom', 'United States', 'Other'];
---

<Base
  title="Twin Partner Network | Fractional Leaders Who Twin with the FCMO Practice"
  description="Vetted senior specialists who pair with Fractionalogic's FCMO practice, or with each other, to extend leadership coverage across functions. Apply to join the roster."
>
  <PageHeader
    title="Twin Partner Network"
    crumbs={[{ label: 'Partners' }]}
    lede="Vetted specialists who pair with the FCMO practice, or with each other, to extend leadership coverage across functions."
  >
    <Fragment slot="actions">
      <a class="btn btn-secondary" href="#apply">Apply to join the roster</a>
    </Fragment>
    <div slot="aside" class="glance panel">
      <ul class="glance__marks" aria-hidden="true">
        {roster.map((p) => <li>{initials(p.name)}</li>)}
      </ul>
      <p class="glance__count"><span class="num">{roster.length}</span> vetted specialists</p>
      <p>Across {functionSummary}.</p>
    </div>
  </PageHeader>

  <section class="roster container section" aria-labelledby="roster-title">
    <h2 id="roster-title" class="h2">The roster</h2>
    <FilterGroup
      label="Filter partners by function"
      options={partnerFunctions.map((f) => ({ value: slug(f), label: f }))}
      noun={['partner', 'partners']}
    >
      <ul class="roster__grid">
        {
          roster.map((partner) => (
            <li data-filter-tags={partner.functions.map(slug).join(' ')}>
              <PartnerCard partner={partner} />
            </li>
          ))
        }
      </ul>
    </FilterGroup>
  </section>

  <section id="apply" class="apply container section" aria-labelledby="apply-title">
    <div class="apply__intro">
      <h2 id="apply-title" class="h2">Build your fractional practice inside a leadership system.</h2>
      <p>
        We are selective. Roster partners are senior operators who can carry a mandate, work to shared KPIs and unified reporting
        alongside an FCMO, and hand back capability the client keeps. If that describes your practice, tell us about it.
      </p>
    </div>

    <div class="apply__form surface">
      <Form
        id="roster-application"
        subject="Twin Partner Network application"
        submitLabel="Apply to join the roster"
        successTitle="Application received"
        successBody="Thank you for telling us about your practice. Every application is read personally, and we’ll be in touch if there’s a fit with a current or upcoming engagement."
      >
        <Field label="Name" name="name" required autocomplete="name" />
        <Field label="Email" name="email" type="email" required autocomplete="email" />
        <Field label="LinkedIn profile" name="linkedin" type="url" required hint="The full link, starting with https://" wide />
        <Field label="Primary function" name="function" as="select" options={functionOptions} required />
        <Field label="Region you work from" name="region" as="select" options={regionOptions} required />
        <Field
          label="Your practice"
          name="practice"
          as="textarea"
          required
          wide
          hint="The mandates you carry, the clients you serve, and how you work alongside other leaders."
        />
      </Form>
    </div>
  </section>
</Base>

<style>
  .glance {
    display: grid;
    gap: 14px;
    color: var(--color-text-on-panel);
  }

  .glance__marks {
    display: flex;
    margin-bottom: 8px;
  }

  .glance__marks li {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-left: -10px;
    background: var(--color-dark);
    border: 3px solid var(--color-panel);
    border-radius: 50%;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-weight: 600;
    color: var(--color-on-dark-muted);
  }

  .glance__marks li:first-child {
    margin-left: 0;
  }

  .glance__marks li:nth-child(even) {
    background: var(--color-action);
    color: var(--color-on-dark);
  }

  .glance__count {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: clamp(1.5rem, 1.2vw + 1.1rem, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-heading);
  }

  .roster {
    display: grid;
    gap: 32px;
  }

  .roster__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .apply {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .apply__intro {
    display: grid;
    gap: 16px;
    position: sticky;
    top: 128px;
  }

  @media (max-width: 900px) {
    .roster__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .apply {
      grid-template-columns: 1fr;
    }

    .apply__intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .roster__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
