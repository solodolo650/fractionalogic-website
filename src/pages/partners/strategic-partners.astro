---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import waterfall from '../../assets/images/banner-waterfall.png';
import { routes } from '../../data/site';
import { getReport, reportDownloadHref } from '../../lib/resources';

const deepDive = await getReport('partner-methodology-deep-dive');
// Deep-dive actions show only once the report is published (see isPublishable).
const deepDiveHref = deepDive ? reportDownloadHref(deepDive) : undefined;
const deepDiveFile = Boolean(deepDive?.data.file);

// The partnership's three principles: each pair reads "this, before that".
const principles = [
  { lead: 'Evidence', rest: 'before assumption' },
  { lead: 'Ownership', rest: 'before activity' },
  { lead: 'Capability', rest: 'before dependency' },
];

const outcomes = [
  'Decisions made in days instead of quarters.',
  'Non-obvious risk and opportunity surfaced from people who never reach the boardroom.',
  'Execution — because every session ends in an owned commitment.',
];

const instruments = [
  {
    name: 'Momentum Zone',
    text: 'A structured readiness assessment that sharpens the opening diagnostic, pinpointing whether a growth stall is a positioning, sales-execution, or product problem.',
  },
  {
    name: 'Huddle',
    text: 'A collective-intelligence platform that surfaces frontline insight fast, feeding the Fractional CMO wider evidence than scheduled interviews alone.',
  },
  {
    name: 'Skill Forge',
    text: 'A capability index that tracks whether the team built during the engagement can execute the plan after it ends.',
  },
];

const frameworks = [
  { name: 'C3', steps: ['Consult', 'Coach', 'Conquer'], text: 'The delivery philosophy behind every FCMO engagement.' },
  { name: 'R4', steps: ['Repair', 'Replenish', 'Recreate', 'Relaunch'], text: 'The brand-renewal sequence an engagement can lead to.' },
];
---

<Base
  title="Strategic Partners | Magic Pencils and Fractionalogic"
  description="Fractionalogic's strategic partnership with Magic Pencils closes the seam between market readiness and revenue execution, with Momentum Zone, Huddle, and Skill Forge supporting every FCMO engagement."
>
  <PageHeader
    title="Measure what is holding growth back."
    current="Strategic Partners"
    crumbs={[{ label: 'Partners' }]}
    lede="Then put senior leadership behind the answer."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={routes.bookConversation}>Talk to the partners</a>
      {deepDiveHref && <a class="btn btn-secondary" href={deepDiveHref} download={deepDiveFile || undefined}>Take the deep dive</a>}
    </Fragment>
    <figure slot="aside" class="pact panel">
      <figcaption class="pact__title">
        <span><strong>Magic</strong> meets <strong>Logic</strong></span>
        <span class="pact__sub">A partnership of Thought + Leadership</span>
      </figcaption>
      <div class="pact__pair" aria-hidden="true">
        <span class="pact__side">
          <span class="pact__name">Magic Pencils</span>
          <span class="pact__role">Thought</span>
        </span>
        <span class="pact__join">+</span>
        <span class="pact__side pact__side--logic">
          <span class="pact__name">Fractionalogic</span>
          <span class="pact__role">Leadership</span>
        </span>
      </div>
      <ul class="pact__principles">
        {
          principles.map((pr) => (
            <li>
              <strong>{pr.lead}</strong>
              <span>{pr.rest}</span>
            </li>
          ))
        }
      </ul>
    </figure>
  </PageHeader>

  <section class="mp container section" aria-labelledby="mp-title">
    <div class="mp__intro">
      <h2 id="mp-title" class="h2">Magic Pencils</h2>
      <p>
        Chennai-based Magic Pencils is a measurement-first transformation practice. Its instruments show where the organization
        stands, surface the commitments people will own, and test whether the required capability exists. The client keeps the
        software, data, baseline, and the ability to re-run the reading.
      </p>
    </div>

  </section>

  <section class="seams container section" aria-labelledby="seams-title">
    <div class="section-head">
      <h2 id="seams-title" class="h2">Growth rarely stalls in one function. It stalls in the seams.</h2>
      <p>
        Magic Pencils prevents the engagement from beginning with assumptions. Fractionalogic prevents the diagnosis from
        ending as a report.
      </p>
    </div>

    <div class="seam-map" role="img" aria-label="Magic Pencils covers readiness, decisions and capability; the Fractional CMO turns each reading into positioning, go-to-market plans and pipeline outcomes.">
      <p class="seam-map__owner">Magic Pencils instruments</p>
      <ol class="seam-map__track">
        <li>Readiness</li>
        <li>Decisions</li>
        <li>Capability</li>
      </ol>
      <p class="seam-map__owner seam-map__owner--fcmo">The FCMO turns each reading into</p>
      <ol class="seam-map__track seam-map__track--fcmo">
        <li>Positioning</li>
        <li>Go-to-market plans</li>
        <li>Pipeline outcomes</li>
      </ol>
    </div>

    <div class="outcomes">
      <h3 class="outcomes__title">What the client gets</h3>
      <ul class="outcomes__list">
        {outcomes.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="founder container section" aria-labelledby="senthil-title">
    <span class="founder__mark" aria-hidden="true">SB</span>
    <div class="founder__text">
      <h2 id="senthil-title" class="h3">Senthil Kumar Bellukutty</h2>
      <p class="founder__role">Founder, Magic Pencils Consulting</p>
      <p>
        Transformation consultant and leadership coach with over 25 years in technology, business consulting, and
        organizational transformation. Creator of Huddle, Momentum Zone, and Skill Forge.
      </p>
    </div>
  </section>

  <section class="instruments container section" aria-labelledby="instruments-title">
    <h2 id="instruments-title" class="h2">Three instruments support an FCMO engagement</h2>
    <ul class="rule-list">
      {
        instruments.map((i) => (
          <li>
            <h3 class="rule-list__label">{i.name}</h3>
            <p>{i.text}</p>
          </li>
        ))
      }
    </ul>

    <ul class="frameworks">
      {
        frameworks.map((f) => (
          <li class="framework surface">
            <h3 class="framework__name">{f.name}</h3>
            <ol class="framework__steps">
              {f.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>

    {deepDiveHref && (
    <div class="instruments__more">
      <p>Full mechanics for each instrument, and the C3 and R4 frameworks, are in the Partner Methodology Deep Dive.</p>
      <a class="btn btn-secondary" href={deepDiveHref} download={deepDiveFile || undefined}>
        {deepDiveFile ? 'Download the partner methodology deep dive' : 'See the partner methodology deep dive'}
      </a>
    </div>
    )}
  </section>

  <CtaBand
    title="Start with a diagnostic conversation."
    body="Every engagement starts with a diagnostic conversation on your current marketing leadership gap, growth stage, and go-to-market priorities."
    action={{ label: 'Book an FCMO Conversation', href: routes.bookConversation }}
    image={waterfall}
  />
</Base>

<style>
  /* Magic Pencils -------------------------------------------------- */
  .mp__intro {
    display: grid;
    gap: 16px;
    max-width: var(--measure);
  }

  /* Hero panel: the two partners joined, then the shared principles as a
     ruled ledger. Text on Mist stays Graphite / Teal 950. */
  .pact {
    display: grid;
    gap: 24px;
    margin: 0;
    color: var(--color-text-on-panel);
  }

  .pact__title {
    display: grid;
    gap: 4px;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: clamp(1.5rem, 1vw + 1.15rem, 1.875rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .pact__title strong {
    font-weight: 600;
  }

  .pact__sub {
    font-family: var(--font-body, inherit);
    font-variation-settings: normal;
    font-size: 0.9375rem;
    letter-spacing: 0;
    color: var(--color-text-on-panel);
  }

  .pact__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 10px;
  }

  .pact__side {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    background: var(--color-surface);
    border-radius: var(--radius);
  }

  .pact__side--logic {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .pact__name {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .pact__role {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .pact__side--logic .pact__role {
    color: var(--color-on-dark);
  }

  .pact__join {
    align-self: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-action);
  }

  .pact__principles {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule-on-panel);
  }

  .pact__principles li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-rule-on-panel);
  }

  .pact__principles strong {
    min-width: 6.5em;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-heading);
  }


  /* Seams ---------------------------------------------------------- */
  .seams {
    display: grid;
    gap: 40px;
  }

  .seam-map {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 12px 24px;
    align-items: center;
    padding: clamp(24px, 3vw, 40px);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .seam-map__owner {
    font-weight: 600;
    color: var(--color-heading);
  }

  .seam-map__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .seam-map__track li {
    position: relative;
    padding: 14px 16px;
    background: var(--color-panel);
    font-weight: 500;
    color: var(--color-text-on-panel);
  }

  .seam-map__track li:first-child {
    border-radius: 6px 0 0 6px;
  }

  .seam-map__track li:last-child {
    border-radius: 0 6px 6px 0;
  }

  /* The seam: a hairline gap between stages, marked where each reading hands over. */
  .seam-map__track li + li {
    border-left: 2px dashed var(--color-highlight);
  }

  .seam-map__track--fcmo li {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .seam-map__track--fcmo li + li {
    border-left-color: var(--color-on-dark-muted);
  }

  .outcomes {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 16px 24px;
    margin-top: 32px;
  }

  .outcomes__title {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .outcomes__list {
    display: grid;
    gap: 12px;
    max-width: var(--measure);
  }

  .outcomes__list li {
    position: relative;
    padding-left: 28px;
  }

  .outcomes__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 14px;
    height: 8px;
    border-left: 2px solid var(--color-action);
    border-bottom: 2px solid var(--color-action);
    transform: rotate(-45deg);
  }

  /* Founder -------------------------------------------------------- */
  .founder {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .founder__mark {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    background: var(--color-dark);
    border-radius: 50%;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-on-dark-muted);
  }

  .founder__text {
    display: grid;
    gap: 8px;
    max-width: var(--measure);
  }

  .founder__role {
    font-weight: 600;
    color: var(--color-action);
  }

  /* Instruments ---------------------------------------------------- */
  .instruments {
    display: grid;
    gap: 40px;
  }

  .frameworks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .framework {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .framework__name {
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .framework__steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .framework__steps li {
    padding: 6px 12px;
    background: var(--color-panel);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-on-panel);
  }

  .instruments__more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 40px;
    align-items: center;
    padding-top: 28px;
    border-top: 1px solid var(--color-rule);
  }

  @media (max-width: 900px) {
    .frameworks,
    .instruments__more {
      grid-template-columns: 1fr;
    }

    .seam-map,
    .outcomes {
      grid-template-columns: 1fr;
    }

    .seam-map__owner--fcmo {
      margin-top: 12px;
    }
  }

  @media (max-width: 560px) {
    .pact__role {
      font-size: 1.1875rem;
    }

    .seam-map__track {
      grid-template-columns: 1fr;
    }

    .seam-map__track li:first-child {
      border-radius: 6px 6px 0 0;
    }

    .seam-map__track li:last-child {
      border-radius: 0 0 6px 6px;
    }

    .seam-map__track li + li {
      border-left: 0;
      border-top: 2px dashed var(--color-highlight);
    }

    .seam-map__track--fcmo li + li {
      border-top-color: var(--color-on-dark-muted);
    }

    .founder {
      grid-template-columns: 1fr;
    }
  }
</style>
