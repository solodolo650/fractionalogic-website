---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import waterfall from '../../assets/images/banner-waterfall.png';
import { routes } from '../../data/site';
import { getReport, reportDownloadHref } from '../../lib/resources';

const deepDive = await getReport('partner-methodology-deep-dive');
const deepDiveHref = deepDive ? reportDownloadHref(deepDive) : routes.resources;
const deepDiveFile = Boolean(deepDive?.data.file);

const loop = ['See', 'Align', 'Perform'];

const outcomes = [
  'Decisions made in days instead of quarters.',
  'Non-obvious risk and opportunity surfaced from people who never reach the boardroom.',
  'Execution — because every session ends in an owned commitment.',
];

const instruments = [
  {
    name: 'Momentum Zone',
    text: 'A structured readiness assessment that sharpens the opening diagnostic, pinpointing whether a growth stall is a positioning, sales-execution, or product problem.',
  },
  {
    name: 'Huddle',
    text: 'A collective-intelligence platform that surfaces frontline insight fast, feeding the Fractional CMO wider evidence than scheduled interviews alone.',
  },
  {
    name: 'Skill Forge',
    text: 'A capability index that tracks whether the team built during the engagement can execute the plan after it ends.',
  },
];

const frameworks = [
  { name: 'C3', steps: ['Consult', 'Coach', 'Conquer'], text: 'The delivery philosophy behind every FCMO engagement.' },
  { name: 'R4', steps: ['Repair', 'Replenish', 'Recreate', 'Relaunch'], text: 'The brand-renewal sequence an engagement can lead to.' },
];
---

<Base
  title="Strategic Partners | Magic Pencils and Fractionalogic"
  description="Fractionalogic's strategic partnership with Magic Pencils closes the seam between market readiness and revenue execution, with Momentum Zone, Huddle, and Skill Forge supporting every FCMO engagement."
>
  <PageHeader
    title="Strategic Partners"
    crumbs={[{ label: 'Partners' }]}
    lede="One partnership, built to close the seam between market readiness and revenue execution."
  >
    <Fragment slot="actions">
      <a class="btn btn-primary" href={routes.bookConversation}>Book an FCMO Conversation</a>
      <a class="btn btn-secondary" href={deepDiveHref} download={deepDiveFile || undefined}>
        {deepDiveFile ? 'Download the methodology deep dive' : 'See the methodology deep dive'}
      </a>
    </Fragment>
    <figure slot="aside" class="philosophy panel">
      <p class="philosophy__formula">Technology × Judgment × Purpose</p>
      <ol class="loop" aria-label="Delivered through a loop">
        {
          loop.map((step) => (
            <li class="loop__step">
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <figcaption class="philosophy__caption">Magic Pencils’ philosophy, delivered through a See → Align → Perform loop.</figcaption>
    </figure>
  </PageHeader>

  <section class="mp container section" aria-labelledby="mp-title">
    <div class="mp__intro">
      <h2 id="mp-title" class="h2">Magic Pencils</h2>
      <p>
        Magic Pencils is a Chennai-based transformation firm working at the intersection of Design Thinking, Agility, and
        Generative AI. Its position: enterprise change fails not for lack of answers, but in the seams — between knowing where a
        business stands, deciding what to do, and building the capability to execute.
      </p>
    </div>

  </section>

  <section class="seams container section" aria-labelledby="seams-title">
    <div class="section-head">
      <h2 id="seams-title" class="h2">Two seams, closed together</h2>
      <p>
        Our Fractional CMO practice closes a parallel seam — between marketing strategy and revenue execution. Magic Pencils
        instruments the organization’s readiness, decisions, and capability; the FCMO turns each reading into positioning,
        go-to-market plans, and pipeline outcomes a client can measure.
      </p>
    </div>

    <div class="seam-map" role="img" aria-label="Magic Pencils covers readiness, decisions and capability; the Fractional CMO turns each reading into positioning, go-to-market plans and pipeline outcomes.">
      <p class="seam-map__owner">Magic Pencils instruments</p>
      <ol class="seam-map__track">
        <li>Readiness</li>
        <li>Decisions</li>
        <li>Capability</li>
      </ol>
      <p class="seam-map__owner seam-map__owner--fcmo">The FCMO turns each reading into</p>
      <ol class="seam-map__track seam-map__track--fcmo">
        <li>Positioning</li>
        <li>Go-to-market plans</li>
        <li>Pipeline outcomes</li>
      </ol>
    </div>

    <div class="outcomes">
      <h3 class="outcomes__title">What the client gets</h3>
      <ul class="outcomes__list">
        {outcomes.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="founder container section" aria-labelledby="senthil-title">
    <span class="founder__mark" aria-hidden="true">SB</span>
    <div class="founder__text">
      <h2 id="senthil-title" class="h3">Senthil Kumar Bellukutty</h2>
      <p class="founder__role">Founder, Magic Pencils Consulting</p>
      <p>
        Transformation consultant and leadership coach with over 25 years in technology, business consulting, and
        organizational transformation. Creator of Huddle, Momentum Zone, and Skill Forge.
      </p>
    </div>
  </section>

  <section class="instruments container section" aria-labelledby="instruments-title">
    <h2 id="instruments-title" class="h2">Three instruments support an FCMO engagement</h2>
    <ul class="rule-list">
      {
        instruments.map((i) => (
          <li>
            <h3 class="rule-list__label">{i.name}</h3>
            <p>{i.text}</p>
          </li>
        ))
      }
    </ul>

    <ul class="frameworks">
      {
        frameworks.map((f) => (
          <li class="framework surface">
            <h3 class="framework__name">{f.name}</h3>
            <ol class="framework__steps">
              {f.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="instruments__more">
      <p>Full mechanics for each instrument, and the C3 and R4 frameworks, are in the Partner Methodology Deep Dive.</p>
      <a class="btn btn-secondary" href={deepDiveHref} download={deepDiveFile || undefined}>
        {deepDiveFile ? 'Download the partner methodology deep dive' : 'See the partner methodology deep dive'}
      </a>
    </div>
  </section>

  <CtaBand
    title="Start with a diagnostic conversation."
    body="Every engagement starts with a diagnostic conversation on your current marketing leadership gap, growth stage, and go-to-market priorities."
    action={{ label: 'Book an FCMO Conversation', href: routes.bookConversation }}
    image={waterfall}
  />
</Base>

<style>
  /* Magic Pencils -------------------------------------------------- */
  .mp__intro {
    display: grid;
    gap: 16px;
    max-width: var(--measure);
  }

  .philosophy {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  .philosophy__caption {
    font-size: 0.9375rem;
    color: var(--color-text-on-panel);
  }

  .philosophy__formula {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: clamp(1.5rem, 1.2vw + 1.1rem, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-heading);
  }

  .loop {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 10px 0;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .loop__step {
    display: flex;
    align-items: center;
  }

  .loop__step span {
    padding: 8px 16px;
    background: var(--color-dark);
    border-radius: var(--radius-pill);
    font-weight: 600;
    color: var(--color-on-dark);
  }

  .loop__step + .loop__step::before,
  .loop__step:last-child::after {
    content: '';
    width: 28px;
    height: 2px;
    margin-inline: 6px;
    background: var(--color-action);
  }

  /* The trailing connector closes the loop back to "See". */
  .loop__step:last-child::after {
    width: 18px;
    background: repeating-linear-gradient(90deg, var(--color-action) 0 4px, transparent 4px 8px);
  }

  /* Seams ---------------------------------------------------------- */
  .seams {
    display: grid;
    gap: 40px;
  }

  .seam-map {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 12px 24px;
    align-items: center;
    padding: clamp(24px, 3vw, 40px);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .seam-map__owner {
    font-weight: 600;
    color: var(--color-heading);
  }

  .seam-map__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .seam-map__track li {
    position: relative;
    padding: 14px 16px;
    background: var(--color-panel);
    font-weight: 500;
    color: var(--color-text-on-panel);
  }

  .seam-map__track li:first-child {
    border-radius: 6px 0 0 6px;
  }

  .seam-map__track li:last-child {
    border-radius: 0 6px 6px 0;
  }

  /* The seam: a hairline gap between stages, marked where each reading hands over. */
  .seam-map__track li + li {
    border-left: 2px dashed var(--color-highlight);
  }

  .seam-map__track--fcmo li {
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .seam-map__track--fcmo li + li {
    border-left-color: var(--color-on-dark-muted);
  }

  .outcomes {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 16px 24px;
    margin-top: 32px;
  }

  .outcomes__title {
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .outcomes__list {
    display: grid;
    gap: 12px;
    max-width: var(--measure);
  }

  .outcomes__list li {
    position: relative;
    padding-left: 28px;
  }

  .outcomes__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 14px;
    height: 8px;
    border-left: 2px solid var(--color-action);
    border-bottom: 2px solid var(--color-action);
    transform: rotate(-45deg);
  }

  /* Founder -------------------------------------------------------- */
  .founder {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .founder__mark {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    background: var(--color-dark);
    border-radius: 50%;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-on-dark-muted);
  }

  .founder__text {
    display: grid;
    gap: 8px;
    max-width: var(--measure);
  }

  .founder__role {
    font-weight: 600;
    color: var(--color-action);
  }

  /* Instruments ---------------------------------------------------- */
  .instruments {
    display: grid;
    gap: 40px;
  }

  .frameworks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .framework {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .framework__name {
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .framework__steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .framework__steps li {
    padding: 6px 12px;
    background: var(--color-panel);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-on-panel);
  }

  .instruments__more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 40px;
    align-items: center;
    padding-top: 28px;
    border-top: 1px solid var(--color-rule);
  }

  @media (max-width: 900px) {
    .frameworks,
    .instruments__more {
      grid-template-columns: 1fr;
    }

    .seam-map,
    .outcomes {
      grid-template-columns: 1fr;
    }

    .seam-map__owner--fcmo {
      margin-top: 12px;
    }
  }

  @media (max-width: 560px) {
    .loop__step span {
      padding: 7px 12px;
      font-size: 0.9375rem;
    }

    .loop__step + .loop__step::before {
      width: 14px;
      margin-inline: 4px;
    }

    .loop__step:last-child::after {
      width: 12px;
      margin-inline: 4px;
    }

    .seam-map__track {
      grid-template-columns: 1fr;
    }

    .seam-map__track li:first-child {
      border-radius: 6px 6px 0 0;
    }

    .seam-map__track li:last-child {
      border-radius: 0 0 6px 6px;
    }

    .seam-map__track li + li {
      border-left: 0;
      border-top: 2px dashed var(--color-highlight);
    }

    .seam-map__track--fcmo li + li {
      border-top-color: var(--color-on-dark-muted);
    }

    .founder {
      grid-template-columns: 1fr;
    }
  }
</style>
