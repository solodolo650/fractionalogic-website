---
import { Image } from 'astro:assets';
import waterfall from '../../assets/images/banner-waterfall.png';
import { routes } from '../../data/site';
---

<section
  class="regions container section photo-card on-dark"
  aria-labelledby="regions-title"
  style="--tint: linear-gradient(86deg, color-mix(in srgb, var(--color-dark) 90%, transparent) 0%, color-mix(in srgb, var(--color-dark) 55%, transparent) 55%, color-mix(in srgb, var(--color-dark) 15%, transparent) 100%)"
>
  <Image class="photo-card__bg" src={waterfall} alt="" widths={[1060]} sizes="(min-width: 1100px) 1060px, 100vw" />
  <div class="regions__text">
    <h2 id="regions-title" class="h3">Fractionalogic, one base, a global reach.</h2>
    <p>
      Based in India, Fractionalogic helps startups access fractional leadership for greater agility and cost
      efficiency.
    </p>
    <p class="regions__stat"><span class="num">223,000</span> DPIIT-recognized startups in India</p>
  </div>
  <a class="btn btn-glass regions__cta" href={routes.footprint}>See the footprint</a>
</section>

<style>
  .regions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding: clamp(32px, 5vw, 56px);
  }

  .regions__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
  }

  .regions__stat {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--color-rule-on-dark);
    color: var(--color-on-dark-muted);
  }

  .regions__stat .num {
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-on-dark);
  }

  .regions__cta {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .regions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
