---
import { initials } from '../../data/partners';

const testimonials = [
  {
    quote: [
      'Working with Murali over the past two years has been both enriching and exploratory. We collaborated closely on go-to-market strategies for several mission-critical initiatives.',
      'He has a unique ability to guide founding teams with the right guardrails while shaping clear, compelling narratives that strengthen market positioning. A highlight was defining the UnicusAI brand — a rewarding journey in which Murali played a pivotal role in bringing clarity and coherence.',
    ],
    name: 'Karthik Murugian',
    role: 'Co-founder & Chief Executive Officer',
    company: 'OptiSol Business Solutions Pvt. Ltd',
  },
  {
    quote: [
      'Murali has given OptiSol strategic clarity and marketing discipline. He shifted our focus from technical capabilities to clear market positioning and business value, backed by a structured brand playbook. He strengthened our go-to-market strategy by aligning marketing, sales, and leadership, improving our founder and corporate brands, and refining product positioning.',
      'I highly recommend Murali to founder-led tech companies that need a Fractional CMO for strategic direction, innovative thinking, and sustainable marketing capabilities.',
    ],
    name: 'Prem Kumar',
    role: 'Co-founder & Head of Growth',
    company: 'OptiSol Business Solutions Pvt. Ltd',
  },
];
---

<section class="testimonial container section" aria-labelledby="testimonial-title">
  <header class="split">
    <div class="split__head">
      <p class="eyebrow">Testimonials | Fraternity speak</p>
      <h2 id="testimonial-title" class="h2">Leadership trust</h2>
    </div>
  </header>

  <ul class="testimonial__grid">
    {
      testimonials.map((t) => (
        <li class="testimonial__card">
          <figure>
            <blockquote>
              {t.quote.map((para, i) => (
                <p>
                  {i === 0 && '“'}
                  {para}
                  {i === t.quote.length - 1 && '”'}
                </p>
              ))}
            </blockquote>
            <figcaption class="testimonial__byline">
              <span class="testimonial__mark" aria-hidden="true">
                {initials(t.name)}
              </span>
              <span class="testimonial__who">
                <span class="testimonial__name">{t.name}</span>
                <span class="testimonial__role">
                  {t.role}
                  <br />
                  {t.company}
                </span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Many voices, set apart from the founder's single voice: split header,
     then a full-width row of cards on the Services and Resources rhythm. */
  .testimonial .h2 {
    max-width: 10em;
  }

  .testimonial__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 56px;
  }

  .testimonial__card {
    display: flex;
    padding: clamp(24px, 3vw, 32px);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }

  .testimonial__card figure {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0;
  }

  .testimonial__card blockquote {
    display: grid;
    gap: 14px;
  }

  .testimonial__card blockquote p {
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Byline settles to the card's foot so names align across the row. */
  .testimonial__byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--color-rule);
  }

  .testimonial__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--color-dark);
    border-radius: 50%;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-on-dark-muted);
  }

  .testimonial__who {
    display: grid;
    gap: 2px;
  }

  .testimonial__name {
    font-weight: 600;
    color: var(--color-heading);
  }

  .testimonial__role {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .testimonial__grid {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
