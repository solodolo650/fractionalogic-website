---
import { routes } from '../../data/site';
import { getReport, reportDownloadHref } from '../../lib/resources';

const businessCase = await getReport('fcmo-business-case');
const caseFile = Boolean(businessCase?.data.file);
const caseHref = businessCase ? reportDownloadHref(businessCase) : routes.resources;
---

<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">Senior marketing leadership, applied fractionally.</h1>
  <p class="hero__body">
    When B2B SaaS growth outpaces founder-led marketing, Fractionalogic steps in with an embedded, revenue-accountable,
    evidence-led Fractional CMO and a leadership system that scales with your business.
  </p>
  <div class="hero__actions">
    <a class="btn btn-primary" href={routes.bookConversation}>Book an FCMO Conversation</a>
    <a class="btn btn-secondary" href={caseHref} download={caseFile || undefined}>
      Read the FCMO Business Case
    </a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-top: clamp(88px, 10vw, 143px);
    text-align: center;
  }

  .hero__title {
    max-width: 16em;
    font-size: clamp(2.375rem, 3.6vw + 1.1rem, 4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .hero__body {
    max-width: var(--measure);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }

  @media (max-width: 560px) {
    .hero {
      align-items: stretch;
    }
    .hero__title,
    .hero__body {
      margin-inline: auto;
    }
    .hero__actions {
      flex-direction: column;
    }
  }
</style>
