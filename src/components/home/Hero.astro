---
import { routes } from '../../data/site';
import { getReport, reportDownloadHref } from '../../lib/resources';

const businessCase = await getReport('fcmo-business-case');
const caseFile = Boolean(businessCase?.data.file);
const caseHref = businessCase ? reportDownloadHref(businessCase) : routes.resources;
---

<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">Senior marketing leadership, applied fractionally.</h1>
  <p class="hero__body">
    Growth exposes the limits of founder-led marketing. Fractionalogic gives growth-stage B2B SaaS founders an embedded, revenue-accountable, and evidence-led
    Fractional CMO, built to extend into a full leadership system as those needs grow.
  </p>
  <div class="hero__actions">
    <a class="btn btn-primary" href={routes.bookConversation}>Book an FCMO Conversation</a>
    <a class="btn btn-secondary" href={caseHref} download={caseFile || undefined}>
      {caseFile ? 'Download the FCMO Business Case' : 'See the FCMO Business Case'}
    </a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-top: clamp(88px, 10vw, 143px);
    text-align: center;
  }

  .hero__title {
    max-width: 16em;
    font-size: clamp(2.375rem, 3.6vw + 1.1rem, 4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .hero__body {
    max-width: var(--measure);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }

  @media (max-width: 560px) {
    .hero {
      align-items: stretch;
    }
    .hero__title,
    .hero__body {
      margin-inline: auto;
    }
    .hero__actions {
      flex-direction: column;
    }
  }
</style>
