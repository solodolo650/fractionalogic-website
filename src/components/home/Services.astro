---
import { Image } from 'astro:assets';
import mountain from '../../assets/images/card-fcmo-mountain.png';
import coast from '../../assets/images/card-twinning-coast.png';
import { routes } from '../../data/site';

const cards = [
  {
    title: 'Fractional CMO',
    body: 'A part-time Chief Marketing Officer embeds into your leadership team, builds the strategy, and owns revenue-facing marketing outcomes.',
    cta: 'See how FCMO works',
    href: routes.fcmo,
    image: mountain,
    tint: 'linear-gradient(285deg, color-mix(in srgb, var(--color-dark) 15%, transparent) 10%, color-mix(in srgb, var(--color-dark) 90%, transparent) 88%)',
  },
  {
    title: 'Fractional Twinning',
    body: 'Two fractional executives work together with shared KPIs and joint accountability, covering broader commercial or operational ground at fractional capacity. This is a deliberate extension to the FCMO practice.',
    cta: 'Learn more about Twinning',
    href: routes.twinning,
    image: coast,
    tint: 'linear-gradient(313deg, color-mix(in srgb, var(--color-brand) 10%, transparent) 20%, color-mix(in srgb, var(--color-brand) 92%, transparent) 82%)',
  },
];
---

<section class="services container section" aria-labelledby="services-title">
  <header class="services__header split">
    <div class="split__head">
      <p class="eyebrow">Services</p>
      <h2 id="services-title" class="h2">One practice. One path.</h2>
    </div>
    <p class="services__intro">
      Fractionalogic's core practice is the Fractional CMO — senior marketing leadership embedded into your team,
      owning revenue-facing outcomes. As businesses grow, needs often extend beyond marketing alone. Fractional
      Twinning brings a second senior leader into the mix, adding expertise across finance, technology, or
      operations at the same fractional capacity.
    </p>
  </header>

  <ul class="services__grid">
    {
      cards.map((card) => (
        <li class="photo-card service-card on-dark" style={`--tint: ${card.tint}`}>
          <Image
            class="photo-card__bg"
            src={card.image}
            alt=""
            widths={[510, 1020]}
            sizes="(min-width: 900px) 510px, 100vw"
          />
          <h3 class="service-card__title">{card.title}</h3>
          <p class="service-card__body">{card.body}</p>
          <a class="text-link service-card__cta" href={card.href}>
            {card.cta} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Intro sits on the right column and settles to the heading's baseline. */
  .services__header {
    align-items: end;
  }

  .services__intro {
    max-width: var(--measure);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 56px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-height: 360px;
    padding: 42px 40px 40px;
  }

  .service-card__title {
    max-width: 6em;
    font-size: clamp(2rem, 1.6vw + 1.4rem, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .service-card__body {
    max-width: 40ch;
    font-weight: 500;
  }

  .service-card__cta {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 700;
  }

  /* Whole card is the click target; the CTA carries the accessible name. */
  .service-card__cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-card:has(.service-card__cta:focus-visible) {
    outline: 2px solid var(--color-action);
    outline-offset: 3px;
  }

  .service-card__cta:focus-visible {
    outline: none;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 48px;
    }
  }

  @media (max-width: 560px) {
    .service-card {
      padding: 32px 24px 28px;
      min-height: 340px;
    }
  }
</style>
