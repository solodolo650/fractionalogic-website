---
import { Image } from 'astro:assets';
import portrait from '../../assets/images/founder-muralidharan-erumbala-portrait.jpg';
import { routes } from '../../data/site';
---

<section class="founder container section split" aria-labelledby="founder-title">
  <div class="founder__aside">
    <div class="split__head">
      <p class="eyebrow">Our story</p>
      <h2 id="founder-title" class="h2">A note from the founder</h2>
    </div>
    <span class="portrait-frame founder__frame">
      <Image
        class="founder__photo"
        src={portrait}
        alt="Portrait of Muralidharan Erumbala"
        widths={[420, 820, 1200]}
        sizes="(min-width: 900px) 410px, 100vw"
      />
    </span>
  </div>

  <figure class="founder__note ruled-quote">
    <blockquote>
      <p>
        “After four decades in marketing leadership across IT, FMCG, manufacturing, retail, financial services, and
        telecom, I built Fractionalogic on one conviction: senior leadership should be flexible without losing
        structure. That’s the practice I run today.”
      </p>
    </blockquote>
    <figcaption class="founder__byline">
      <span class="ruled-quote__name">Muralidharan Erumbala</span>
      <span>Founder, Fractionalogic &amp; Fractional CMO</span>
      <span class="founder__award">
        World Marketing Congress Top 100 Most Innovative Marketing Technology Leader, 2019
      </span>
    </figcaption>
    <a class="text-link" href={routes.about}>Read the full story <span aria-hidden="true">→</span></a>
  </figure>
</section>

<style>
  /* Left column: heading on the section's top line, portrait settled to its
     bottom. Right column: the ruled quote, whose byline and link settle to
     the same bottom line, so both columns start and end together. */
  .founder {
    align-items: stretch;
  }

  .founder__aside {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* The portrait is shot 4:3 with headroom, so it shows uncropped. */
  .founder__frame {
    margin-top: auto;
  }

  .founder__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .founder__byline {
    margin-top: auto;
  }

  /* Graphite on Executive Brass (6.08:1): the page's prestige accent, reserved for the award. */
  .founder__award {
    align-self: flex-start;
    margin-top: 12px;
    max-width: 48ch;
    padding: 6px 12px;
    background: var(--color-prestige);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-on-panel);
  }

  @media (max-width: 900px) {
    .founder__frame {
      max-width: 400px;
    }
  }
</style>
