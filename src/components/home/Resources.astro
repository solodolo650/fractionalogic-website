---
import ResourceCard from '../ui/ResourceCard.astro';
import { routes } from '../../data/site';
import { getResources } from '../../lib/resources';

const resources = await getResources();
const picks = [...resources.filter((r) => r.data.featured), ...resources.filter((r) => !r.data.featured)].slice(0, 3);
---

<section class="resources container section" aria-labelledby="resources-title">
  <header class="resources__header">
    <h2 id="resources-title" class="h2">Resources</h2>
    <a class="text-link" href={routes.resources}>View all resources <span aria-hidden="true">→</span></a>
  </header>

  <ul class="resources__grid">
    {
      picks.map((r) => (
        <li>
          <ResourceCard resource={r} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .resources__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .resources__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 56px;
  }

  @media (max-width: 900px) {
    .resources__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .resources__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
