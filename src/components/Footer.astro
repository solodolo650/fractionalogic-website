---
import { contact, partners, routes, services } from '../data/site';

const columns = [
  { heading: 'Services', links: services },
  { heading: 'Partners', links: partners },
  {
    heading: 'Company',
    links: [
      { label: 'About', href: routes.about },
      { label: 'Resources', href: routes.resources },
      { label: 'Talk to Us', href: routes.talkToUs },
      { label: 'LinkedIn', href: contact.linkedin, external: true },
    ],
  },
];

const legal = [
  { label: 'Disclaimer', href: routes.disclaimer },
  { label: 'Terms of Use', href: routes.terms },
  { label: 'Privacy Policy', href: routes.privacy },
];

const year = new Date().getFullYear();
---

<!-- A lean, light footer: wordmark and the brand line, three link columns, one legal row. -->
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={routes.home}>fractionalogic</a>
      <p class="footer__line">
        Senior leadership logic,
        <span>applied fractionally.</span>
      </p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div>
            <h2 class="footer__heading">{col.heading}</h2>
            <ul class="footer__list">
              {col.links.map((link) => (
                <li>
                  {'external' in link && link.external ? (
                    <a href={link.href} rel="noopener">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>© {year} Muralidharan Erumbala</p>
    <ul class="footer__legal">
      {
        legal.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    padding-top: 56px;
    padding-bottom: 28px;
    border-top: 1px solid var(--color-rule);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 3fr);
    gap: 48px;
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .footer__logo {
    justify-self: start;
    color: var(--color-brand);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .footer__line {
    display: grid;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .footer__line span {
    color: var(--color-text-muted);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer__heading {
    font-family: inherit;
    font-variation-settings: normal;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .footer__list {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .footer__list a,
  .footer__legal a {
    color: var(--color-text);
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .footer__list a {
    font-size: 0.9375rem;
  }

  .footer__list a:hover,
  .footer__legal a:hover {
    color: var(--color-action);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 32px;
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--color-rule);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
  }

  .footer__legal a {
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 560px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }
</style>
