---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  lede?: string;
  crumbs?: Crumb[];
  /** Breadcrumb label when the page title is a sentence rather than the page name. */
  current?: string;
}

const { title, lede, crumbs = [], current } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<header class:list={['page-header', 'container', { 'page-header--split': hasAside }]}>
  <div class="page-header__main">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {crumbs.map((crumb) => <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}</li>)}
        <li aria-current="page">{current ?? title}</li>
      </ol>
    </nav>
    <h1 class="page-title">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    {
      Astro.slots.has('actions') && (
        <div class="page-header__actions">
          <slot name="actions" />
        </div>
      )
    }
    <slot />
  </div>
  {
    hasAside && (
      <div class="page-header__aside">
        <slot name="aside" />
      </div>
    )
  }
</header>

<style>
  .page-header {
    display: grid;
    gap: 48px;
    padding-top: clamp(72px, 8vw, 112px);
  }

  .page-header--split {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(40px, 5vw, 72px);
  }

  .page-header__main {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .page-header .page-title {
    max-width: 16em;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .breadcrumb li + li::before {
    content: '/';
    padding-inline: 10px;
    color: var(--color-rule);
  }

  .breadcrumb a {
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-action);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .breadcrumb [aria-current] {
    color: var(--color-text);
  }

  .page-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .page-header--split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .page-header__actions {
      width: 100%;
      flex-direction: column;
    }
  }
</style>
