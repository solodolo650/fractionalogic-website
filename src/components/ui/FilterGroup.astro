---
/*
 * Chip filter as progressive enhancement. Filterable children carry
 * data-filter-tags="a b"; a wrapper marked data-filter-section hides when none of its items match.
 * Without JavaScript the chips stay hidden and every item shows.
 */
interface Option {
  value: string;
  label: string;
  count?: number;
}

interface Props {
  label: string;
  options: Option[];
  noun: [singular: string, plural: string];
  /** Query parameter that mirrors the active filter, so a filtered view can be linked. */
  param?: string;
  total?: number;
}

const { label, options, noun, param, total } = Astro.props;
---

<fl-filter data-singular={noun[0]} data-plural={noun[1]} data-param={param}>
  <div class="filter__bar" role="group" aria-label={label}>
    <button class="chip" type="button" aria-pressed="true" data-filter="">
      All{total !== undefined && <span class="chip__count">{total}</span>}
    </button>
    {
      options.map((o) => (
        <button class="chip" type="button" aria-pressed="false" data-filter={o.value}>
          {o.label}
          {o.count !== undefined && <span class="chip__count">{o.count}</span>}
        </button>
      ))
    }
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>
  <slot />
</fl-filter>

<style>
  fl-filter {
    display: grid;
    gap: 28px;
  }

  .filter__bar {
    display: none;
  }

  fl-filter[data-enhanced] .filter__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip__count {
    margin-left: 8px;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
</style>

<script>
  class FlFilter extends HTMLElement {
    connectedCallback() {
      const chips = [...this.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const items = [...this.querySelectorAll<HTMLElement>('[data-filter-tags]')];
      const sections = [...this.querySelectorAll<HTMLElement>('[data-filter-section]')];
      const status = this.querySelector<HTMLElement>('[data-filter-status]');
      const { singular, plural } = this.dataset;

      const apply = (value: string) => {
        let shown = 0;
        items.forEach((item) => {
          const match = !value || item.dataset.filterTags!.split(' ').includes(value);
          item.hidden = !match;
          if (match) shown++;
        });
        sections.forEach((section) => {
          section.hidden = ![...section.querySelectorAll<HTMLElement>('[data-filter-tags]')].some((item) => !item.hidden);
        });
        chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === value)));
        if (status) status.textContent = `Showing ${shown} ${shown === 1 ? singular : plural}`;
      };

      const param = this.dataset.param;
      const sync = (value: string) => {
        if (!param) return;
        const url = new URL(location.href);
        if (value) url.searchParams.set(param, value);
        else url.searchParams.delete(param);
        history.replaceState(null, '', url);
      };

      chips.forEach((chip) =>
        chip.addEventListener('click', () => {
          const value = chip.dataset.filter ?? '';
          apply(value);
          sync(value);
        }),
      );

      const initial = param ? new URLSearchParams(location.search).get(param) : null;
      if (initial && chips.some((chip) => chip.dataset.filter === initial)) apply(initial);
      this.dataset.enhanced = '';
    }
  }

  if (!customElements.get('fl-filter')) customElements.define('fl-filter', FlFilter);
</script>
