---
import { Image } from 'astro:assets';
import { isExternal, kindLabels, resourceHref, resourceSource, resourceThumbnail, type Resource } from '../../lib/resources';

interface Props {
  resource: Resource;
  headingLevel?: 'h2' | 'h3';
}

const { resource, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const thumb = resourceThumbnail(resource);
const external = isExternal(resource);
---

<article class="rcard">
  <div class:list={['rcard__thumb', { 'rcard__thumb--brand': thumb.isFallback }]} style={`--zoom: ${thumb.zoom}; --pos: ${thumb.position}`}>
    {
      typeof thumb.src === 'string' ? (
        <img src={thumb.src} alt={thumb.alt} width="640" height="400" loading="lazy" decoding="async" />
      ) : (
        <Image
          src={thumb.src}
          alt={thumb.alt}
          widths={[400, 800]}
          sizes="(min-width: 900px) 340px, (min-width: 560px) 50vw, 120px"
        />
      )
    }
  </div>
  <div class="rcard__body">
    <Heading class="rcard__title">
      <a href={resourceHref(resource)} rel={external ? 'noopener' : undefined}>
        {resource.data.title}
        {
          external && (
            <svg class="rcard__ext" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )
        }
      </a>
    </Heading>
    <p class="rcard__meta">
      <span class="rcard__kind">{kindLabels[resource.data.kind]}</span>
      <span>{resourceSource(resource)}</span>
    </p>
  </div>
</article>

<style>
  .rcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    transition: border-color 160ms ease;
  }

  .rcard:hover {
    border-color: var(--color-action);
  }

  .rcard:has(a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .rcard__thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-dark);
  }

  .rcard__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--pos, center);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rcard__thumb--brand :global(img) {
    filter: url(#duotone-logic);
  }

  .rcard:hover .rcard__thumb :global(img) {
    transform: scale(calc(var(--zoom, 1) * 1.04));
  }

  .rcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: 20px 22px 22px;
  }

  .rcard__title {
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .rcard__title a {
    text-decoration: none;
  }

  /* The whole card is the target; the title link carries the accessible name. */
  .rcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .rcard__title a:focus-visible {
    outline: none;
  }

  .rcard:hover .rcard__title a {
    text-decoration: underline;
    text-decoration-color: var(--color-highlight);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .rcard__ext {
    display: inline;
    margin-left: 6px;
    color: var(--color-action);
    vertical-align: 1px;
  }

  .rcard__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    margin-top: auto;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .rcard__kind {
    font-weight: 600;
    color: var(--color-action);
  }

  @media (prefers-reduced-motion: reduce) {
    .rcard:hover .rcard__thumb :global(img) {
      transform: scale(var(--zoom, 1));
    }
  }

  /* Phones: a compact row (thumbnail beside the title) keeps a long library scannable. */
  @media (max-width: 560px) {
    .rcard {
      flex-direction: row;
    }

    .rcard__thumb {
      flex: 0 0 104px;
      aspect-ratio: auto;
      min-height: 112px;
    }

    .rcard__body {
      gap: 10px;
      padding: 14px 16px;
    }

    .rcard__title {
      font-size: 1.0625rem;
    }

    .rcard__meta {
      flex-direction: column;
      gap: 2px;
      font-size: 0.8125rem;
    }
  }
</style>
