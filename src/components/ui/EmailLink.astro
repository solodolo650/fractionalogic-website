---
/* Assembles the address in the browser so it never appears as plain text in the HTML. */
interface Props {
  address: string;
  class?: string;
}

const { address, class: className } = Astro.props;
const [user, domain] = address.split('@');
---

<a class:list={['email-link', className]} data-user={user} data-domain={domain}>
  {user} [at] {domain}
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.email-link[data-user]').forEach((link) => {
    const address = `${link.dataset.user}@${link.dataset.domain}`;
    link.href = `mailto:${address}`;
    link.textContent = address;
  });
</script>
