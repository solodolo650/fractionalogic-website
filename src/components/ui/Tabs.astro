---
/*
 * Accessible tabs as progressive enhancement. Children mark each panel with
 * data-tab-panel="<id>" and give it a .tab-heading; without JavaScript every
 * panel shows in order under its own heading.
 */
interface Tab {
  id: string;
  label: string;
}

interface Props {
  label: string;
  tabs: Tab[];
}

const { label, tabs } = Astro.props;
const uid = label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<fl-tabs data-uid={uid}>
  <div class="tabs__list" role="tablist" aria-label={label}>
    {
      tabs.map((tab, i) => (
        <button
          class="tabs__tab"
          type="button"
          role="tab"
          id={`${uid}-tab-${tab.id}`}
          aria-controls={`${uid}-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div class="tabs__panels">
    <slot />
  </div>
</fl-tabs>

<style>
  fl-tabs {
    display: grid;
    gap: 32px;
  }

  .tabs__list {
    display: none;
  }

  fl-tabs[data-enhanced] .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tabs__tab {
    min-height: 44px;
    padding: 8px 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    font: inherit;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .tabs__tab:hover {
    border-color: var(--color-action);
  }

  .tabs__tab[aria-selected='true'] {
    background: var(--color-selected);
    border-color: var(--color-selected);
    color: var(--color-on-selected);
  }

  /* On phones the tabs stack as a full-width segmented selector instead of a ragged pill cloud. */
  @media (max-width: 560px) {
    fl-tabs[data-enhanced] .tabs__list {
      flex-direction: column;
      gap: 0;
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .tabs__tab {
      width: 100%;
      border: 0;
      border-radius: 0;
      text-align: left;
    }

    .tabs__tab + .tabs__tab {
      border-top: 1px solid var(--color-rule);
    }
  }

  .tabs__panels {
    display: grid;
    gap: 40px;
  }

  fl-tabs[data-enhanced] :global(.tab-heading) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  fl-tabs[data-enhanced] :global([data-tab-panel]:focus-visible) {
    outline-offset: 6px;
  }
</style>

<script>
  class FlTabs extends HTMLElement {
    connectedCallback() {
      const uid = this.dataset.uid;
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = tabs.map((tab) => this.querySelector<HTMLElement>(`[data-tab-panel="${tab.dataset.tab}"]`));
      if (!tabs.length || panels.some((p) => !p)) return;

      panels.forEach((panel, i) => {
        panel!.id = `${uid}-panel-${tabs[i].dataset.tab}`;
        panel!.setAttribute('role', 'tabpanel');
        panel!.setAttribute('aria-labelledby', tabs[i].id);
        panel!.tabIndex = 0;
      });

      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[i]!.hidden = !active;
        });
        if (focus) tabs[index].focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          const next =
            e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
            : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
            : e.key === 'Home' ? 0
            : e.key === 'End' ? last
            : null;
          if (next === null) return;
          e.preventDefault();
          select(next, true);
        });
      });

      select(0);
      this.dataset.enhanced = '';
    }
  }

  if (!customElements.get('fl-tabs')) customElements.define('fl-tabs', FlTabs);
</script>
