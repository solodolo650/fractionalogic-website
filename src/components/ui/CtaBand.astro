---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  body: string;
  action: { label: string; href: string };
  image: ImageMetadata;
  id?: string;
}

const { title, body, action, image, id = 'closing' } = Astro.props;
---

<section
  class="cta-band container section photo-card on-dark"
  aria-labelledby={`${id}-title`}
  style="--tint: linear-gradient(90deg, color-mix(in srgb, var(--color-dark) 92%, transparent) 0%, color-mix(in srgb, var(--color-dark) 70%, transparent) 50%, color-mix(in srgb, var(--color-dark) 30%, transparent) 100%)"
>
  <Image class="photo-card__bg" src={image} alt="" widths={[1060]} sizes="(min-width: 1100px) 1060px, 100vw" />
  <div class="cta-band__text">
    <h2 id={`${id}-title`} class="h2">{title}</h2>
    <p>{body}</p>
  </div>
  <a class="btn btn-secondary cta-band__action" href={action.href}>{action.label}</a>
</section>

<style>
  .cta-band {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: clamp(40px, 6vw, 72px);
  }

  .cta-band__text {
    display: grid;
    gap: 16px;
    max-width: 34rem;
  }

  .cta-band__action {
    flex-shrink: 0;
    border-color: var(--color-on-dark);
  }

  @media (max-width: 900px) {
    .cta-band {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
