---
interface Props {
  links: { id: string; label: string }[];
}

const { links } = Astro.props;
---

<fl-toc>
  <nav class="toc" aria-label="On this page">
    <p class="toc__title">On this page</p>
    <ol class="toc__list">
      {
        links.map((link) => (
          <li>
            <a href={`#${link.id}`} data-toc-link={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</fl-toc>

<style>
  /* The host sticks, not the nav: the host's parent is the stretched grid
     cell, which gives it room to travel the full length of the page. */
  fl-toc {
    display: block;
    position: sticky;
    top: 128px;
  }

  .toc__title {
    margin-bottom: 12px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .toc__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-rule);
  }

  .toc__list a {
    display: block;
    margin-left: -1px;
    padding: 8px 0 8px 16px;
    border-left: 2px solid transparent;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .toc__list a:hover {
    color: var(--color-heading);
  }

  .toc__list a[aria-current='true'] {
    border-left-color: var(--color-action);
    color: var(--color-heading);
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    fl-toc {
      position: static;
    }

    .toc__list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      border-left: 0;
    }

    .toc__list a {
      margin: 0;
      padding: 6px 14px;
      background: var(--color-surface);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      font-size: 0.9375rem;
    }

    .toc__list a[aria-current='true'] {
      border-color: var(--color-action);
    }
  }
</style>

<script>
  class FlToc extends HTMLElement {
    connectedCallback() {
      const links = [...this.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
      const sections = links
        .map((link) => document.getElementById(link.dataset.tocLink!))
        .filter((s): s is HTMLElement => Boolean(s));

      const mark = (id: string) =>
        links.forEach((link) => link.setAttribute('aria-current', String(link.dataset.tocLink === id)));

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) mark(visible[0].target.id);
        },
        { rootMargin: '-20% 0px -65% 0px' },
      );
      sections.forEach((section) => observer.observe(section));
    }
  }

  if (!customElements.get('fl-toc')) customElements.define('fl-toc', FlToc);
</script>
